{
  "format": "ztrip.mgraph",
  "version": 1,
  "name": "Kitchen sink: every Phase 2 node",
  "nodes": [
    {"id": "clock", "type": "BeatClock", "pos": [0, 0]},
    {"id": "kick", "type": "AudioOnset", "params": {"band": "Sub"}, "pos": [0, 120]},
    {"id": "snare", "type": "AudioOnset", "params": {"band": "Mid", "min_velocity": 0.2}, "pos": [0, 240]},
    {"id": "bass", "type": "AudioBand", "params": {"band": "Bass"}, "pos": [0, 360]},
    {"id": "air", "type": "AudioBand", "params": {"band": "Air", "smoothed": false}, "pos": [0, 480]},
    {"id": "air_smooth", "type": "Smooth", "params": {"attack_ms": 20, "release_ms": 300}, "pos": [220, 480]},
    {"id": "bass_gate", "type": "Threshold", "params": {"threshold": 0.6, "hysteresis": 0.1}, "pos": [220, 360]},
    {"id": "air_range", "type": "RemapRange", "params": {"in_min": 0.2, "in_max": 0.8}, "pos": [440, 480]},
    {"id": "air_curve", "type": "ResponseCurve", "params": {"curve": "ease_in", "amount": 2.5}, "pos": [660, 480]},
    {"id": "air_clamp", "type": "Clamp", "params": {"min": 0.05, "max": 0.95}, "pos": [880, 480]},
    {"id": "kick_env", "type": "ADSR", "params": {"attack_ms": 5, "decay_ms": 80, "sustain": 0.4, "hold_ms": 50, "release_ms": 200}, "pos": [220, 120]},
    {"id": "bass_env", "type": "ADSR", "params": {"attack_ms": 30, "decay_ms": 100, "sustain": 0.7, "release_ms": 400}, "pos": [440, 360]},
    {"id": "snare_hit", "type": "ImpulseDecay", "params": {"decay_ms": 180}, "pos": [220, 240]},
    {"id": "sway", "type": "BeatLFO", "params": {"shape": "sine", "beats": 2}, "pos": [220, 0]},
    {"id": "jitter", "type": "BeatLFO", "params": {"shape": "random"}, "pos": [220, -120]},
    {"id": "hits", "type": "Add", "pos": [440, 180]},
    {"id": "light", "type": "Multiply", "pos": [660, 120]},
    {"id": "gain", "type": "Multiply", "pos": [1100, 480]},
    {"id": "floor", "type": "Constant", "params": {"value": 0.25}, "pos": [1100, 600]},
    {"id": "mat", "type": "Add", "pos": [1320, 480]},
    {"id": "out_light", "type": "PropertyOut", "params": {"target": "Lights/Key:light_energy"}, "pos": [880, 120]},
    {"id": "out_mat", "type": "PropertyOut", "params": {"target": "Stage/Floor:shader_parameter/glow"}, "pos": [1540, 480]},
    {"id": "out_cam", "type": "PropertyOut", "params": {"target": "Camera:fov_push"}, "pos": [660, 360]},
    {"id": "out_jitter", "type": "PropertyOut", "params": {"target": "Particles:amount_ratio"}, "pos": [440, -120]},
    {"id": "out_bar", "type": "PropertyOut", "params": {"target": "Stage/Spin:bar_phase"}, "pos": [220, -240]},
    {"id": "out_fall", "type": "PropertyOut", "params": {"target": "Stage/Strobe:fall"}, "pos": [440, 600]}
  ],
  "edges": [
    {"from": "kick.trigger", "to": "kick_env.trigger"},
    {"from": "snare.trigger", "to": "snare_hit.trigger"},
    {"from": "air.out", "to": "air_smooth.in"},
    {"from": "bass.out", "to": "bass_gate.in"},
    {"from": "air_smooth.out", "to": "air_range.in"},
    {"from": "air_range.out", "to": "air_curve.in"},
    {"from": "air_curve.out", "to": "air_clamp.in"},
    {"from": "bass_gate.rise", "to": "bass_env.trigger"},
    {"from": "bass_gate.gate", "to": "bass_env.gate"},
    {"from": "clock.clock", "to": "sway.clock"},
    {"from": "clock.clock", "to": "jitter.clock"},
    {"from": "kick_env.out", "to": "hits.a"},
    {"from": "snare_hit.out", "to": "hits.b"},
    {"from": "hits.out", "to": "light.a"},
    {"from": "sway.out", "to": "light.b"},
    {"from": "air_clamp.out", "to": "gain.a"},
    {"from": "gain.out", "to": "mat.a"},
    {"from": "floor.out", "to": "mat.b"},
    {"from": "light.out", "to": "out_light.in"},
    {"from": "mat.out", "to": "out_mat.in"},
    {"from": "bass_env.out", "to": "out_cam.in"},
    {"from": "jitter.out", "to": "out_jitter.in"},
    {"from": "clock.bar_phase", "to": "out_bar.in"},
    {"from": "bass_gate.fall", "to": "out_fall.in"}
  ],
  "macros": [
    {"name": "Glow", "node": "gain", "param": "b", "min": 0, "max": 2, "default": 1}
  ]
}
