[configuration]

entry_symbol = "ztrip_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/ztrip/bin/libztrip.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/ztrip/bin/libztrip.linux.template_debug.x86_64.so"
windows.debug.x86_64 = "res://addons/ztrip/bin/libztrip.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/ztrip/bin/libztrip.windows.template_debug.x86_64.dll"
