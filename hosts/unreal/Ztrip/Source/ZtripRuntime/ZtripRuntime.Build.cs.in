// The ztrip runtime: the player actor and property binder, plus the
// engine-free ztrip core (analysis, Motion Graph, musical time, host session
// and bake) compiled from source by UnrealBuildTool, so it matches the
// engine's compiler and standard library on every platform. The core lives
// under Public/ztrip and Private/Core; pffft and nlohmann/json under
// Private/ThirdParty.
//
// Generated by hosts/unreal/stage.cmake in the ztrip repository: edit
// ZtripRuntime.Build.cs.in there, not the staged copy.
using System;
using System.IO;
using System.Reflection;
using UnrealBuildTool;

public class ZtripRuntime : ModuleRules
{
	public ZtripRuntime(ReadOnlyTargetRules Target) : base(Target)
	{
		// The core's files are plain C++ (and pffft plain C): no engine PCH,
		// and no unity files, since their file-local helpers may share names.
		PCHUsage = PCHUsageMode.NoPCHs;
		bUseUnity = false;
		CppStandard = CppStandardVersion.Cpp20;
		bEnableExceptions = true; // the core reports load errors with exceptions

		PublicIncludePaths.Add(Path.Combine(ModuleDirectory, "Public"));
		foreach (string Dir in new string[] { @ZTRIP_UE_PRIVATE_INCLUDES@ })
		{
			PrivateIncludePaths.Add(Path.Combine(ModuleDirectory, Dir));
		}
		PrivateDefinitions.AddRange(new string[] { @ZTRIP_UE_DEFINES@ });

		PublicDependencyModuleNames.AddRange(new string[]
		{
			"Core",
			"CoreUObject",
			"Engine",
			"LevelSequence",
		});
		PrivateDependencyModuleNames.AddRange(new string[]
		{
			"Niagara",
		});

		// pffft and nlohmann/json aren't written to the engine's warning
		// rules. The setting names moved between engine versions, so they are
		// set by name where they exist.
		RelaxWarning("ShadowVariableWarningLevel");
		RelaxWarning("UndefinedIdentifierWarningLevel");
		RelaxWarning("UnsafeTypeCastWarningLevel");
		RelaxFlag("bEnableUndefinedIdentifierWarnings");
	}

	private void RelaxWarning(string Name)
	{
		foreach (object Owner in WarningSettingOwners())
		{
			PropertyInfo Property = Owner.GetType().GetProperty(Name);
			if (Property != null && Property.CanWrite && Property.PropertyType.IsEnum)
			{
				Property.SetValue(Owner, Enum.Parse(Property.PropertyType, "Off"));
				return;
			}
			FieldInfo Field = Owner.GetType().GetField(Name);
			if (Field != null && Field.FieldType.IsEnum)
			{
				Field.SetValue(Owner, Enum.Parse(Field.FieldType, "Off"));
				return;
			}
		}
	}

	private void RelaxFlag(string Name)
	{
		PropertyInfo Property = GetType().GetProperty(Name);
		if (Property != null && Property.CanWrite && Property.PropertyType == typeof(bool))
		{
			Property.SetValue(this, false);
			return;
		}
		FieldInfo Field = GetType().GetField(Name);
		if (Field != null && Field.FieldType == typeof(bool))
		{
			Field.SetValue(this, false);
		}
	}

	private object[] WarningSettingOwners()
	{
		PropertyInfo Settings = GetType().GetProperty("CppCompileWarningSettings");
		FieldInfo SettingsField = GetType().GetField("CppCompileWarningSettings");
		object Inner = Settings != null ? Settings.GetValue(this)
			: SettingsField != null ? SettingsField.GetValue(this) : null;
		return Inner != null ? new object[] { Inner, this } : new object[] { this };
	}
}
